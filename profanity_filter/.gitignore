# bundled/fetched tools - re-created per README.md ("Installation")
/bin/

# generated output (cleaned media, reports, temp dirs) - never source
/out/*
!/out/.gitkeep

# Python
__pycache__/
*.pyc

# stemmer venv (audio-separator + CUDA torch/onnxruntime, several GB) - see
# README.md "Stemmer setup" to recreate
/.venv-stem/

# TTS/voice-conversion venv (Piper + RVC + pyworld, several GB) - see
# README.md "TTS/Voice-Conversion setup" to recreate
/.venv-tts/

# per-speaker voice-conversion models trained from a specific media file's
# own audio (see word_replace_synth.py) - cached next to the media, not
# source
*.vc_model.meta.json
*.vc_model/

# OpenSubtitles API key (see opensubtitles.py) - never commit this
/opensubtitles.key

# TMDB API key (see tmdb.py) - never commit this
/tmdb.key
